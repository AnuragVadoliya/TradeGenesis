# TradeGenesis — root .gitignore

# -----------------------------------------------------------------------------
# Secrets and local environment configuration
# -----------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.sample
!**/.env.example
!**/.env.sample

# Private keys / certificates (never commit real secrets)
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# -----------------------------------------------------------------------------
# JavaScript / Node.js (client and server)
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.tsbuildinfo

# Frontend build outputs and Vite cache
client/dist/
**/dist/
**/.vite/

# Generic build / coverage outputs
build/
**/build/
coverage/
**/coverage/
.nyc_output/

# -----------------------------------------------------------------------------
# Python / FastAPI backtesting engine
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.python-version
venv/
.venv/
env/
**/venv/
**/.venv/
**/env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# -----------------------------------------------------------------------------
# Generated market data, local databases, and backtest artifacts
# Review these patterns if you intentionally want to version sample datasets.
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.parquet
*.feather
scrip_master.json
**/scrip_master.json

# Common generated export files; keep these ignored only if they are outputs.
backtest-results/
backtest_results/
backtest-exports/
backtest_exports/

# Temporary files
tmp/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# -----------------------------------------------------------------------------
# Logs and runtime artifacts
# -----------------------------------------------------------------------------
*.log
logs/
**/logs/
*.pid
*.seed
pids/

# -----------------------------------------------------------------------------
# Docker local overrides (keep the main docker-compose.yml and Dockerfiles)
# -----------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.*.override.yml

# -----------------------------------------------------------------------------
# Editors and operating systems
# -----------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.sublime-workspace

# -----------------------------------------------------------------------------
# Git temporary files
# Do not ignore the repository's required source files or deployment configs.
# -----------------------------------------------------------------------------
*.orig
*.rej
